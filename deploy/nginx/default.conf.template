# Production nginx config with TLS. Rendered at container start; ${DOMAIN_NAME}
# is the only substituted variable. Routing matches frontend/nginx.conf.

# Plain HTTP: send everyone to HTTPS.
server {
    listen 80;
    server_name ${DOMAIN_NAME};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Start HSTS at one day; raise max-age once HTTPS has been stable for a while.
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Phone photos are several MB; nginx's default limit is 1 MB.
    client_max_body_size 10m;

    root  /usr/share/nginx/html;
    index index.html;

    # /api and /uploads go to FastAPI with the path unchanged.
    location ~ ^/(api|uploads)/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Vision + LLM calls can be slow.
        proxy_read_timeout 90s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
